# Copy this to config.env and fill in your values, then: source config.env
# config.env is git-ignored (it holds tokens). config.env.example is safe to commit.

# ---- AWS ----
export REGION=us-east-1                 # MUST match your InfluxDB Cloud region
export PACK_ID=SANDBOX-01

# ---- Resource names (leave as-is unless you want different names) ----
export IOT_THING=SANDBOX-01
export IOT_POLICY=sandbox-pack-policy
export IOT_RULE=sandbox_to_influx       # IoT rule names: letters/digits/underscore only
export LAMBDA_ROLE=sandbox-lambda-role
export INGEST_FN=sandbox-ingest
export QUERY_FN=sandbox-query
export API_NAME=helt-sandbox-api

# ---- InfluxDB Cloud ----
export INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
export INFLUXDB_ORG=your-org-name-or-id
export INFLUXDB_BUCKET=helt_telemetry
export INFLUXDB_TOKEN=your-WRITE-scoped-token       # used by sandbox-ingest
export INFLUXDB_READ_TOKEN=your-READ-scoped-token   # used by sandbox-query

# ---- Filled in for you by setup.sh (leave blank) ----
export ACCOUNT=
export IOT_ENDPOINT=
export API_ID=

# ---- API security (spec S1): Cognito ----
# Emails are sign-in usernames; no mail is ever sent (message-action SUPPRESS).
export COGNITO_OPS_EMAIL=helt-ops@example.com       # internal dashboard user
export COGNITO_CUSTA_EMAIL=customer-a@example.com   # S2 demo: packs 01-03, ALL
export COGNITO_CUSTB_EMAIL=customer-b@example.com   # S2 demo: 04-05, no location
# Filled in for you by setup.sh step7 (leave blank):
export COGNITO_POOL_ID=
export COGNITO_CLIENT_ID=
export COGNITO_OPS_PASSWORD=
export COGNITO_CUSTA_PASSWORD=
export COGNITO_CUSTB_PASSWORD=
